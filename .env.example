# =============================================================================
# ComicMe backend environment variables
# Copy to .env for local dev. For production, set these in Railway dashboard.
# =============================================================================

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change_me_to_a_long_random_string_in_production
HOST=0.0.0.0
PORT=8000

# --- Database (Neon Postgres in production) ---
# Either set DATABASE_URL directly (any SQLAlchemy URL), or set the DB_*
# fields below and we will build a postgresql+psycopg URL for you.
#
# Local dev (SQLite):   leave DATABASE_URL as sqlite, leave DB_HOST empty.
# Production (Neon):    either DATABASE_URL OR fill all of DB_HOST/DB_PORT/
#                       DB_USER/DB_PASSWORD/DB_NAME. Keep DB_SSLMODE=require.
DATABASE_URL=sqlite:///./diffrun.db
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=neondb
DB_SSLMODE=require

# --- Gemini (required) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL_MULTIMODAL=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_TXT2IMG=imagen-4.0-generate-001
GEMINI_IMAGE_MODEL_SUBJECT_REF=imagen-3.0-capability-001

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Local dev:        CORS_ORIGINS=http://localhost:3000
# Production:       CORS_ORIGINS=https://comicme.vercel.app
# Multiple origins: CORS_ORIGINS=https://comicme.vercel.app,https://staging.comicme.vercel.app
# Leave empty in non-production to default to "*".
CORS_ORIGINS=

# --- Razorpay (optional) ---
# Set RAZORPAY_ENABLED=true only in production with real keys.
# In dev, leave RAZORPAY_ENABLED=false (or unset) and the API auto-bypasses payment.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_LIVE_MODE=false

# --- Cloudflare R2 (PDF storage; mandatory in production) ---
# In production, local disk does NOT persist across redeploys. Configure R2.
# 1. Create a bucket at https://dash.cloudflare.com -> R2 -> Create bucket.
# 2. (Optional) enable a public dev URL for direct browser downloads.
# 3. Create an API token with object read/write on that bucket.
# 4. Paste the values below.
#
# The first set (R2_ENDPOINT / R2_BUCKET_NAME / R2_PUBLIC_URL) is preferred
# — these match the ourverse convention. The legacy R2_BUCKET / R2_PUBLIC_BASE_URL
# are still accepted as fallbacks. R2_ENDPOINT defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if you set just R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_BUCKET_NAME=comicme-pdfs
R2_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Legacy / fallback names (still supported, lower priority):
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENABLED=false
R2_PRESIGN_EXPIRY_SECONDS=3600

# --- Template paths (relative to repo root) ---
TEMPLATE_BASE_DIR=templates/base
TEMPLATE_MASK_DIR=templates/mask
